# Comma-separated hostnames/domains the optional page reader may fetch.
# Example: example.com,docs.example.org
# Empty disables the reader endpoint.
READER_ALLOWED_HOSTS=

# Optional local listening port
PORT=3000

# Number of trusted reverse-proxy hops. Keep 0 unless your host's proxy topology
# is known and the proxy strips incoming forwarding headers. Do not set blindly.
TRUST_PROXY_HOPS=0

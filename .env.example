# Copy this file to .env on the deployment host. Never commit real secrets or .env.
# Generate a long random value, e.g. openssl rand -hex 32.
SEARXNG_SECRET=replace-with-a-long-random-secret
SEARXNG_BASE_URL=http://localhost:8080/
APP_PORT=3000
PORT=3000

# Exact browser origin only: no path or trailing slash. Adjust if using a custom domain.
ALLOWED_ORIGINS=https://assassincoder188.github.io

# Optional hostnames the page reader is allowed to fetch, comma-separated.
# Leave empty to keep the reader disabled.
READER_ALLOWED_HOSTS=

# Number of trusted reverse-proxy hops. Keep 0 unless deployment topology is verified.
TRUST_PROXY_HOPS=0
